{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "pro.daneo.teamspeak3plugin",
  "name": "Teamspeak3Plugin",
  "version": "0.5.0",
  "description": "A plugin to control teamspeak 3 via macrodeck",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/MacroDeck.Teamspeak3Plugin.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "osx-arm64": {
      "executable": "runtimes/osx-arm64/MacroDeck.Teamspeak3Plugin.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "linux-x64": {
      "executable": "runtimes/linux-x64/MacroDeck.Teamspeak3Plugin.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "DaNeo"
  },
  "license": "MIT",
  "repository": "https://github.com/DaNeo61/MacroDeck.Teamspeak3Plugin",
  "homepage": "https://www.daneo.pro/",
  "compatibility": {
    "macroDeck": ">=3.0.0-0"
  },
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": false
  }
}
